# Satellite tile pack - 33 MB of Esri imagery, regenerable by re-seeding.
# Binary, huge, and not ours to redistribute; keep it out of the history.
tiles/

# Runtime state written by the Spotify poller, not source.
nowplaying.json

# Pre-git safety net. These are the only record of earlier versions, so
# they stay on disk - but git supersedes them from here on. Delete them
# once you trust the history.
confluence_helm.backup-*.html
*.bak-*

# Python bytecode. netd.py is run, never imported as a library, so these
# turn up only when a tool imports it - a test harness or a linter - and
# are regenerated on demand.
__pycache__/
*.pyc

# Editor/OS noise
*.swp
*~
.DS_Store
